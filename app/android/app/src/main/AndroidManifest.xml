<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Cover art (thumbnails.libretro.com) and emulator downloads. Flutter only adds INTERNET
         to debug/profile builds, so release APKs had no network access without this line. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Read game folders in place (Settings → Game folders). Sideloaded app, so all-files access is allowed. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <!-- Install emulator APKs downloaded from their official releases (the user confirms each). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Lets the same APK install on phones, tablets, Fire TV and Android TV. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <application
        android:label="RomRunner"
        android:banner="@drawable/tv_banner"
        android:isGame="true"
        android:requestLegacyExternalStorage="true"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- TV launchers use the banner. Phone and tablet launchers use the
                 icon aliases below; Settings -> App icon switches which is on. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- app-icons:begin (generated by tool/icons/generate_icons.py) -->
        <activity-alias
            android:name=".IconCartridge"
            android:targetActivity=".MainActivity"
            android:label="RomRunner"
            android:icon="@mipmap/ic_icon_cartridge"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconSpeedDpad"
            android:targetActivity=".MainActivity"
            android:label="RomRunner"
            android:icon="@mipmap/ic_icon_speed_dpad"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPixelRr"
            android:targetActivity=".MainActivity"
            android:label="RomRunner"
            android:icon="@mipmap/ic_icon_pixel_rr"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconHandheld"
            android:targetActivity=".MainActivity"
            android:label="RomRunner"
            android:icon="@mipmap/ic_icon_handheld"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconNeonR"
            android:targetActivity=".MainActivity"
            android:label="RomRunner"
            android:icon="@mipmap/ic_icon_neon_r"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPlayPad"
            android:targetActivity=".MainActivity"
            android:label="RomRunner"
            android:icon="@mipmap/ic_icon_play_pad"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPixelRunner"
            android:targetActivity=".MainActivity"
            android:label="RomRunner"
            android:icon="@mipmap/ic_icon_pixel_runner"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconCartStack"
            android:targetActivity=".MainActivity"
            android:label="RomRunner"
            android:icon="@mipmap/ic_icon_cart_stack"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconRetroTv"
            android:targetActivity=".MainActivity"
            android:label="RomRunner"
            android:icon="@mipmap/ic_icon_retro_tv"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconArcadeStick"
            android:targetActivity=".MainActivity"
            android:label="RomRunner"
            android:icon="@mipmap/ic_icon_arcade_stick"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconDiscCart"
            android:targetActivity=".MainActivity"
            android:label="RomRunner"
            android:icon="@mipmap/ic_icon_disc_cart"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPlayR"
            android:targetActivity=".MainActivity"
            android:label="RomRunner"
            android:icon="@mipmap/ic_icon_play_r"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- app-icons:end -->
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Shares Switch games from game folders with the Switch emulator. -->
        <provider
            android:name=".GameFileProvider"
            android:authorities="${applicationId}.games"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/game_paths" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Emulator apps RomRunner can open games in (keep in sync with external_catalog.dart; a test checks). -->
        <package android:name="aenu.aps3e" />
        <package android:name="aenu.aps3e.premium" />
        <package android:name="aenu.ax360e" />
        <package android:name="aenu.ax360e.free" />
        <package android:name="com.armsx2" />
        <package android:name="com.armsx2.nightly" />
        <package android:name="com.izzy2lost.x1box" />
        <package android:name="com.virtualapplications.play" />
        <package android:name="come.nanodata.armsx2" />
        <package android:name="dev.eden.eden_emulator" />
        <package android:name="dev.eden.eden_emulator.nightly" />
        <package android:name="dev.legacy.eden_emulator" />
        <package android:name="info.cemu.Cemu" />
        <package android:name="info.cemu.cemu" />
        <package android:name="io.github.lime3ds.android" />
        <package android:name="org.azahar_emu.azahar" />
        <package android:name="org.dolphinemu.dolphinemu" />
        <package android:name="org.kenjinx.android" />
        <package android:name="org.mupen64plusae.v3.alpha" />
        <package android:name="org.mupen64plusae.v3.fzurita" />
        <package android:name="org.mupen64plusae.v3.fzurita.amazon" />
        <package android:name="org.mupen64plusae.v3.fzurita.pro" />
        <package android:name="org.ppsspp.ppsspp" />
        <package android:name="org.ppsspp.ppssppgold" />
        <package android:name="org.vita3k.emulator" />
        <package android:name="xyz.aethersx2.android" />
        <package android:name="xyz.aethersx2.tturnip" />
        <!-- Find installed Switch emulators that open content:// game files (Android 11+ package visibility). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="content" android:mimeType="application/octet-stream"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
